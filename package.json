{
  "name": "cineforge-landing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy": "npm run build && npx wrangler@latest pages deploy dist --project-name cineforge --branch main",
    "assets": "node scripts/make-assets.mjs",
    "test": "node --test --experimental-strip-types \".github/scripts/**/*.test.mjs\" \"src/**/*.test.ts\"",
    "sync:releases": "node .github/scripts/sync-releases.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.1",
    "i18next": "^27.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.1",
    "oxlint": "^1.90.0",
    "puppeteer-core": "^25.18.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
